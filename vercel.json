{
  "version": 2,
  "framework": null,
  "installCommand": "npm install",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{index.html,public/**,db/**,lib/**,scripts/raw-to-report/**,scripts/load-report-cli.js}"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
