# Server port (default 8000)
PORT=8000

# --- Groq (free tier, OpenAI-compatible) — https://console.groq.com/keys ---
# Paste your key from Groq Console (starts with gsk_). Use either line:
GROQ_API_KEY=
# OPENAI_API_KEY=gsk_your_key_here

OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile

# --- Fallback AI provider for Room chatbot (OpenRouter) ---
# Used automatically when the primary AI provider is rate-limited, out of credits, or temporarily down.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_HTTP_REFERER=http://127.0.0.1:8000
OPENROUTER_APP_TITLE=ITC Analytics Portal

# Faster / lighter model (optional):
# OPENAI_MODEL=llama-3.1-8b-instant

# --- OpenAI (paid) — uncomment and comment Groq lines above ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- Live report data (Smartler API, proxied by server.js) ---
# SMARTLER_REPORT_API_URL=https://anlyeng.smartler.in/report/raw/download-fast
# SMARTLER_GROUP=itc

# --- Report load cache (month switching) ---
# Past months auto-expire after 10 days; current calendar month is not time-cleared.
# Use "Retry loading data" in the UI to refresh the current month from Smartler.
REPORT_CACHE_ENABLED=true
REPORT_CACHE_MAX_ENTRIES=12
# 10 days in milliseconds (864000000)
REPORT_CACHE_TTL_PAST_MS=864000000
REPORT_CACHE_SWEEP_MS=3600000

# --- PostgreSQL auth / role-based access control ---
# Required when authentication is enabled.
# Set AUTH_DISABLED=true for local report-only mode without login/database.
# AUTH_DISABLED=true
# No-password local example:
DATABASE_URL=postgres://postgres@localhost:5432/usage_report
# Password local example:
# DATABASE_URL=postgres://postgres:your_password@localhost:5432/usage_report
# Set true only when serving over HTTPS in production.
COOKIE_SECURE=false
SESSION_COOKIE_NAME=itc_session
SESSION_TTL_DAYS=7

# --- SMTP email for new-user access emails ---
PORTAL_PUBLIC_URL=http://127.0.0.1:8000/login
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ITC Analytics Portal <no-reply@example.com>"
